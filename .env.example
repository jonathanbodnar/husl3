# ── Conversation model (runs every turn; the brain sits in its cached prefix) ──
DEEPSEEK_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-v4-pro
# on | off — thinking costs output tokens and latency; the audit reads better without it
CHAT_THINKING=off
# USD per million tokens (DeepSeek V4 Pro, peak). Off-peak is half. Used only for the cost meter.
CHAT_PRICE_HIT=0.044
CHAT_PRICE_MISS=1.32
CHAT_PRICE_OUT=3.96

# ── Prompt writer (one call per audit; writes the coding-agent prompts) ──
# Default: Qwen3.8 Max 0902 on Alibaba Cloud Model Studio, US (Virginia) endpoint.
# Singapore: https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1 (legacy: https://dashscope-intl.aliyuncs.com/compatible-mode/v1)
# Any OpenAI-compatible endpoint works: OpenRouter (qwen/qwen3.8-max-0902), Kimi K3, Claude via a proxy…
DASHSCOPE_API_KEY=
PROMPT_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
PROMPT_MODEL=qwen3.8-max-0902
# on | off — reasoning before writing. Measured on Model Studio, one prompt (Sep 2026):
#   off: 19s, 0.9¢ · on + PROMPT_THINKING_BUDGET=3000: 31s, 1.2¢ · on, uncapped: 243s, 6.6¢ (9k reasoning tokens).
# The budget (max reasoning tokens) is honored by Model Studio only; on other hosts "on" is uncapped.
PROMPT_THINKING=on
PROMPT_THINKING_BUDGET=3000
# on | off — send response_format json_object (DashScope + OpenRouter support it)
PROMPT_JSON_MODE=on
PROMPT_PRICE_IN=2.00
PROMPT_PRICE_CACHED=0.25
PROMPT_PRICE_OUT=6.00

# ── OAuth brokers (optional; without them the connect dialog falls back to tokens and connection strings) ──
# Public origin used for OAuth callbacks, e.g. https://husl.ai. When set, every other public host (the *.up.railway.app one)
# redirects here, so sessions, callbacks and the sign-in relay share one origin. Leave empty to derive from the request.
APP_ORIGIN=
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App.
#   Authorization callback URL: https://<your-domain>/api/auth/github/callback   (one URL per app; register husl.ai once DNS is live)
#   Scope requested at sign-in: repo (read access to private repositories; GitHub OAuth apps have no read-only private scope)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Supabase → Organization settings → OAuth Apps → Add application.
#   Redirect URL: https://<your-domain>/api/auth/supabase/callback
#   Scopes: Organizations (read), Projects (read), Database (write — the Management API's query endpoint requires it even though this app only ever sends read_only queries)
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=

# ── Abuse limits (there are no accounts, so the operator's keys are the thing to protect) ──
# Optional shared code; when set the app asks for it once and sends it with every request.
ACCESS_CODE=
# Hard stop for the day, in USD, across all visitors (in-memory; resets at UTC midnight).
DAILY_BUDGET_USD=10
# Per-IP limits per rolling hour. The client IP comes from X-Forwarded-For, which is only trustworthy
# behind a proxy — set TRUST_PROXY_HOPS to the number of proxies in front (Railway: 1; bare server: 0).
TRUST_PROXY_HOPS=1
RATE_CHAT_PER_HOUR=60
RATE_SCAN_PER_HOUR=20
RATE_PROMPTS_PER_HOUR=10
# Ceilings across everyone, so a forged header cannot multiply usage. 0 disables.
RATE_GLOBAL_CHAT_PER_HOUR=600
RATE_GLOBAL_SCAN_PER_HOUR=300
RATE_GLOBAL_PROMPTS_PER_HOUR=120

# Verify TLS certificates on founder Postgres connections (off: managed providers present certs we
# have no root for). Private/loopback database hosts are refused unless ALLOW_PRIVATE_DB_HOSTS=on.
DB_STRICT_TLS=off
ALLOW_PRIVATE_DB_HOSTS=off
MAX_TOOL_ROUNDS=12

PORT=8787
